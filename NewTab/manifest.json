{
  "manifest_version": 3,
  "name": "macOS Glass New Tab",
  "version": "1.0",
  "description": "A beautiful macOS-style glass new tab page with your most useful apps",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
