{
  "manifest_version": 3,
  "name": "Webpage to PDF",
  "version": "1.0",
  "description": "Convert any webpage to a PDF document with one click — supports full-page capture, custom paper size, and orientation options.",
  "permissions": ["activeTab", "downloads", "debugger", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
