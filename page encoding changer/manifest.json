{
  "manifest_version": 3,
  "name": "Page Encoding Changer",
  "version": "1.0.0",
  "description": "Force change page encoding with a single click",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
