{
  "manifest_version": 3,
  "name": "Lite Embed Player for YouTube™",
  "version": "1.0",
  "description": "Opens YouTube videos in a lightweight embed player.",
  "permissions": [
    "activeTab",
    "declarativeContent"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in YouTube Lite"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
