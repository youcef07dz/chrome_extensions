{
  "manifest_version": 3,
  "name": "GitHub to GitHub.io",
  "version": "1.0",
  "description": "Click icon to redirect GitHub repo URLs to GitHub Pages URLs",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GitHub Pages"
  },
  "icons": {
    "128": "icon128.png"
  }
}
